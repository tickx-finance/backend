NODE_ENV=local
PORT='3001'
WORKER_PORT='3002'
NETWORK=mainnet

POSTGRES_URL=postgres://root:1@localhost:5432/test

REDIS_URL=redis://foobared@localhost:6379/1

MINIO_ACCESS_KEY=development
MINIO_SECRET_KEY=password
BUCKET_NAME=development
MINIO_HOST=localhost
MINIO_PORT=9000

RPC=https://api.zan.top/eth-sepolia

KAFKA_BROKER=localhost:39092
KAFKA_TOPIC_PREFIX='prefix'

BLOCKVISION_API_KEY=key

KAFKA_RUNNING_FLAG=true
RUN_PRICE_TICK=true
RUN_SETTLEMENT=true
GRID_ENGINE=fortress
FORTRESS_BANDWIDTH_WARMUP_TICKS=100
FORTRESS_BANDWIDTH_REFRESH_TICKS=3600

# Authentication
JWT_SECRET=your-jwt-secret
APP_API_KEY=your-api-key-for-cre-workflows

# Blockchain
ADMIN_PRIVATE_KEY=0x...
CELL_SIGNER_KEY=0x...

# Analytics
CLICKHOUSE_URL=http://root:1@localhost:8123/default

QUOTE_ASSET_ADDRESS=0x8603a12c549007a3AFE026EFAD797640Bda30760
RESERVE_POOL_ADDRESS=0x6351b3006aAE72a36006614310928930Ac229d0e
RPCS=rpc1,rpc2,rpc3
CLAIM_SIGNER_PRIVATE_KEY=
PAYMENT_CHAIN_SYNC_ENABLED=false
PAYMENT_CHAIN_SYNC_START_BLOCK=0
PAYMENT_CHAIN_SYNC_CONFIRMATIONS=6
PAYMENT_CHAIN_SYNC_CHUNK_SIZE=2000
PAYMENT_CHAIN_SYNC_POLL_MS=10000
PAYMENT_WITHDRAWAL_EXPIRY_ENABLED=true
PAYMENT_WITHDRAWAL_EXPIRY_POLL_MS=30000
PAYMENT_WITHDRAWAL_EXPIRY_BATCH_SIZE=100
